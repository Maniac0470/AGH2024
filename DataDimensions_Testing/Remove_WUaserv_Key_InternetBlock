<#
.SYNOPSIS
    Removes the Windows Update policy "DoNotConnectToWindowsUpdateInternetLocations" 
    (if set to 1) from remote computers to allow internet-based Windows Update.

.DESCRIPTION
    Checks HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate\DoNotConnectToWindowsUpdateInternetLocations
    - If value = 1 → removes the value (unblocks internet WSUS)
    - If value = 0 or absent → leaves unchanged
    - Reports original value, action taken, final state, and any errors

    Requires:
    - WinRM enabled on targets
    - Administrative privileges on target computers

.PARAMETER ComputerName
    One or more computer names to process. Accepts pipeline input.

.PARAMETER Credential
    Optional PSCredential with admin rights on the target computers.

.PARAMETER Path
    Optional path to CSV/TXT file with computer names 
    (tries columns: Device, ComputerName, Hostname, Name, Computer, Server).

.EXAMPLE
    .\Remove-WUInternetBlock.ps1 -ComputerName JUVCOCXDA001 -Credential $adminCred

.EXAMPLE
    Get-Content nonprod_hosts.txt | .\Remove-WUInternetBlock.ps1 -Credential $cred

.EXAMPLE
    .\Remove-WUInternetBlock.ps1 -Path "C:\servers.csv"

.EXAMPLE
    # Show usage / help when run empty
    .\Remove-WUInternetBlock.ps1

.EXAMPLE
    Get-Help .\Remove-WUInternetBlock.ps1 -Full
#>

[CmdletBinding(SupportsShouldProcess = $true, ConfirmImpact = 'Medium')]
param(
    [Parameter(Mandatory = $false, ValueFromPipeline = $true, Position = 0)]
    [Alias("Computer", "Name", "HostName", "Server")]
    [string[]] $ComputerName,

    [Parameter(Mandatory = $false)]
    [PSCredential] $Credential,

    [Parameter(Mandatory = $false)]
    [string] $Path,

    [Parameter(Mandatory = $false)]
    [switch] $WhatIf
)

begin {
    # ──────────────────────────────────────────────────────────────
    # Show friendly usage when run with no arguments
    # ──────────────────────────────────────────────────────────────
    if ($PSBoundParameters.Count -eq 0 -and $MyInvocation.Line -notmatch ' -') {
        Write-Host "`nRemove-WUInternetBlock - Remove WSUS-only internet block (if enabled) on remote computers`n" -ForegroundColor Cyan
        
        Write-Host "Important:" -ForegroundColor Yellow
        Write-Host "  This script MODIFIES the registry and requires ADMIN rights on targets.`n" -ForegroundColor Yellow
        
        Write-Host "Quick usage examples:" -ForegroundColor White
        Write-Host "  .\Remove-WUInternetBlock.ps1 -ComputerName JUVCOCXDA001 -Credential `$cred" -ForegroundColor White
        Write-Host "  Get-Content servers.txt | .\Remove-WUInternetBlock.ps1 -Credential `$cred" -ForegroundColor White
        Write-Host "  .\Remove-WUInternetBlock.ps1 -Path C:\nonprod_hosts.csv" -ForegroundColor White
        Write-Host "  Get-Help .\Remove-WUInternetBlock.ps1 -Full" -ForegroundColor White
        Write-Host "`nUse -WhatIf to preview changes without applying them.`n" -ForegroundColor Gray
        
        return
    }

    $allComputers = [System.Collections.Generic.List[string]]::new()

    # ── Load from CSV/file if provided ───────────────────────────────
    if ($Path -and (Test-Path $Path -PathType Leaf)) {
        Write-Verbose "Reading computer list from: $Path"
        $content = if ($Path -like "*.csv") { Import-Csv $Path } else { Get-Content $Path }
        
        $possibleColumns = @('Device', 'ComputerName', 'Hostname', 'Name', 'Computer', 'Server')
        if ($content -is [array] -and $content[0] -is [PSObject]) {
            $found = $possibleColumns | Where-Object { $content[0].PSObject.Properties.Name -contains $_ } | Select-Object -First 1
            if ($found) { $allComputers.AddRange(($content | Select-Object -Expand $found)) }
        }
        else {
            $allComputers.AddRange($content)
        }
    }

    # ── Add from parameter / pipeline ────────────────────────────────
    if ($ComputerName) {
        $allComputers.AddRange($ComputerName)
    }

    $allComputers = $allComputers |
        Where-Object { $_ -and $_.Trim() } |
        Sort-Object -Unique

    if ($allComputers.Count -eq 0) {
        Write-Error "No valid computer names provided."
        return
    }

    Write-Verbose "Processing $($allComputers.Count) computer(s)"
    
    $results = [System.Collections.Generic.List[PSObject]]::new()
}

process {
    foreach ($computer in $allComputers) {
        Write-Verbose "→ $computer"

        try {
            $invokeParams = @{
                ComputerName = $computer
                ScriptBlock  = {
                    $keyPath   = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate"
                    $valueName = "DoNotConnectToWindowsUpdateInternetLocations"

                    $result = [PSCustomObject]@{
                        Computer   = $env:COMPUTERNAME
                        Original   = "Unknown"
                        Action     = "None"
                        FinalState = "Unknown"
                        Error      = $null
                    }

                    try {
                        $current = Get-ItemProperty -Path $keyPath -Name $valueName -ErrorAction SilentlyContinue

                        if ($current) {
                            $val = $current.$valueName
                            $result.Original = $val

                            if ($val -eq 1) {
                                # Remove only if -WhatIf not active
                                if ($PSCmdlet.ShouldProcess($env:COMPUTERNAME, "Remove registry value $valueName (was 1)")) {
                                    Remove-ItemProperty -Path $keyPath -Name $valueName -ErrorAction Stop
                                    $result.Action     = "Removed (was blocking internet WSUS)"
                                    $result.FinalState = "Value deleted"
                                }
                                else {
                                    $result.Action     = "Would remove (WhatIf)"
                                    $result.FinalState = "Value still 1"
                                }
                            }
                            else {
                                $result.Action     = "Left unchanged"
                                $result.FinalState = "Value was $val (not blocking)"
                            }
                        }
                        else {
                            $result.Original   = "Absent"
                            $result.Action     = "None"
                            $result.FinalState = "Not present"
                        }
                    }
                    catch {
                        $result.Error  = $_.Exception.Message
                        $result.Action = "Failed"
                    }

                    $result
                }
                ErrorAction  = 'Stop'
            }

            if ($Credential) { $invokeParams.Credential = $Credential }

            $result = Invoke-Command @invokeParams

            $null = $results.Add($result)
        }
        catch {
            Write-Warning "Failed to connect to $computer : $($_.Exception.Message)"
            $null = $results.Add([PSCustomObject]@{
                Computer   = $computer
                Original   = "N/A"
                Action     = "Failed"
                FinalState = "Connection error"
                Error      = $_.Exception.Message
            })
        }
    }
}

end {
    if ($results.Count -eq 0) {
        Write-Host "No results." -ForegroundColor DarkGray
        return
    }

    Write-Host "`nWindows Update Internet Block Removal Report`n" -ForegroundColor Cyan

    $results | 
        Sort-Object Computer | 
        Format-Table Computer, Original, Action, FinalState, Error -AutoSize

    $changed = $results.Where({ $_.Action -like "*Removed*" }).Count
    $failed  = $results.Where({ $_.Action -eq "Failed" }).Count

    Write-Host "`nSummary:" -ForegroundColor Gray
    Write-Host "  Computers processed : $($results.Count)"
    Write-Host "  Keys removed        : $changed" -ForegroundColor $(if ($changed -gt 0) { 'Green' } else { 'Gray' })
    Write-Host "  Failures            : $failed"  -ForegroundColor $(if ($failed -gt 0)  { 'Red'   } else { 'Gray' })

    # Optional export (uncomment if desired)
    # $results | Export-Csv -Path "WU_InternetBlock_Removal_$(Get-Date -Format yyyyMMdd-HHmm).csv" -NoTypeInformation -Encoding UTF8
}